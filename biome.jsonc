{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/node_modules", "!**/.next", "!**/coverage", "!**/plan", "!**/*.md"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "warn"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": { "level": "error", "options": { "allow": ["error", "warn"] } }
      },
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "error",
        "useNamingConvention": "off"
      },
      "security": { "noDangerouslySetInnerHtml": "error" },
      // Spelled out rather than inherited from the top-level preset: accessibility is a product
      // requirement here, not a default. (`biome migrate` rewrites this to `"preset": "none"`,
      // which silently disables every a11y rule — do not accept that change.)
      "a11y": { "preset": "recommended" },
      "complexity": {
        // Off on purpose. tsconfig.base.json sets `noPropertyAccessFromIndexSignature`, which
        // requires `env['KEY']` for index-signature types; this rule's fix (`env.KEY`) is exactly
        // what that compiler flag rejects, so applying it would break `pnpm typecheck`.
        "useLiteralKeys": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": { "maxAllowedComplexity": 24 }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/cli.ts", "scripts/**", "**/*.test.ts", "**/*.test.tsx", "test/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    }
  ]
}
