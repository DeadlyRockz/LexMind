# LexMind configuration. Copy to .env.local and fill in. NEVER commit a real key.

# Google AI Studio key. Read in exactly one file: packages/core/src/model/adapters/gemini.ts
# Leave blank to run LexMind fully offline: the deterministic engine needs no key at all.
GEMINI_API_KEY=

# Force the deterministic replay adapter. Any attempt to reach the network becomes a hard
# failure rather than a silent live call. CI sets this to 1.
LEXMIND_OFFLINE=1

# Model tiering. Keep flash-lite for extraction (thinking off by default => cheapest + most
# repeatable) and flash for explanation and Q&A.
LEXMIND_MODEL_ANALYSIS=gemini-2.5-flash
LEXMIND_MODEL_EXTRACT=gemini-2.5-flash-lite
LEXMIND_MODEL_EMBED=gemini-embedding-2

# Denial-of-wallet ceilings, enforced before any request leaves the process.
LEXMIND_MAX_PROMPT_TOKENS=120000
LEXMIND_MAX_OUTPUT_TOKENS=4096
